# Copy to .env and adjust:  cp .env.example .env
# The defaults work out of the box for a local demo. Change every password and
# token before exposing anything beyond your own machine.

TZ=Asia/Kolkata

# --- Simulator
DRONE_COUNT=4
TICK_HZ=1

# --- InfluxDB
INFLUX_ADMIN_USER=admin
INFLUX_ADMIN_PASSWORD=change-me-influx
INFLUX_ORG=aeronode
INFLUX_BUCKET=telemetry
INFLUX_RETENTION=7d
INFLUX_TOKEN=aeronode-dev-token-change-me

# --- Grafana
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-grafana

# --- n8n
N8N_ENCRYPTION_KEY=change-me-to-a-long-random-string
# Optional: fill both to receive alerts on Telegram (see README)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Engine
NOTIFY_MIN_SEVERITY=warning
# Optional: require an X-API-Key header on control endpoints
API_KEY=
