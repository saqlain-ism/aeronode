{
  "uid": "aeronode-fleet",
  "title": "AeroNode - Fleet Operations",
  "tags": [
    "aeronode",
    "uav",
    "telemetry"
  ],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "5s",
      "10s",
      "30s",
      "1m"
    ]
  },
  "schemaVersion": 39,
  "version": 1,
  "templating": {
    "list": [
      {
        "name": "drone",
        "label": "Drone",
        "type": "query",
        "datasource": {
          "type": "influxdb",
          "uid": "influxdb-aeronode"
        },
        "query": "import \"influxdata/influxdb/schema\"\nschema.tagValues(bucket: \"telemetry\", tag: \"drone_id\")",
        "definition": "drone_id tag values",
        "multi": true,
        "includeAll": true,
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "refresh": 2,
        "sort": 1
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "name": "Critical events",
        "enable": true,
        "iconColor": "red",
        "datasource": {
          "type": "influxdb",
          "uid": "influxdb-aeronode"
        },
        "target": {
          "refId": "Anno",
          "query": "from(bucket: \"telemetry\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"events\" and r._field == \"message\" and r.severity == \"critical\")\n  |> map(fn: (r) => ({_time: r._time, _value: r.drone_id + \": \" + r._value}))"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
