              },
              {
                "id": "decimals",
                "value": 0
              },
              {
                "id": "displayName",
                "value": "from home"
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "md"
      }
    },
    {
      "id": 7,
      "type": "table",
      "title": "Decision & event log",
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb-aeronode"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 16,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-aeronode"
          },
          "query": "from(bucket: \"telemetry\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"events\" and r._field == \"message\" and r.type != \"MODE_CHANGED\")\n  |> filter(fn: (r) => contains(value: r.drone_id, set: ${drone:json}))\n  |> group()\n  |> sort(columns: [\"_time\"], desc: true)\n  |> limit(n: 200)\n  |> keep(columns: [\"_time\", \"drone_id\", \"severity\", \"type\", \"action\", \"_value\"])\n  |> rename(columns: {_value: \"message\"})"
        }
      ],
      "fieldConfig": {
        "defaults": {},
