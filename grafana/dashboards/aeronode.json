                      "HOLD": {
                        "color": "yellow",
                        "index": 1
                      },
                      "DESCEND": {
                        "color": "yellow",
                        "index": 2
                      },
                      "RTL": {
                        "color": "orange",
                        "index": 3
                      },
                      "LAND": {
                        "color": "red",
                        "index": 4
                      },
                      "LANDED": {
                        "color": "text",
                        "index": 5
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "battery"
