    {
      "id": 5,
      "type": "geomap",
      "title": "Live fleet map",
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb-aeronode"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 12
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-aeronode"
          },
          "query": "from(bucket: \"telemetry\")\n  |> range(start: -1m)\n  |> filter(fn: (r) => r._measurement == \"telemetry\" and (r._field == \"lat\" or r._field == \"lon\" or r._field == \"battery\" or r._field == \"alt\"))\n  |> filter(fn: (r) => contains(value: r.drone_id, set: ${drone:json}))\n  |> group(columns: [\"drone_id\", \"_field\"])\n  |> last()\n  |> pivot(rowKey: [\"drone_id\"], columnKey: [\"_field\"], valueColumn: \"_value\")\n  |> group()\n  |> keep(columns: [\"drone_id\", \"lat\", \"lon\", \"battery\", \"alt\"])"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 25
              },
              {
                "color": "green",
                "value": 40
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "view": {
          "id": "coords",
          "lat": 17.4474,
          "lon": 78.3762,
          "zoom": 14.5,
          "allLayers": true
        },
        "controls": {
          "showZoom": true,
          "mouseWheelZoom": true,
          "showAttribution": true
        },
        "basemap": {
          "type": "default",
          "name": "Basemap"
        },
        "layers": [
          {
            "type": "markers",
            "name": "Drones",
            "tooltip": true,
            "location": {
              "mode": "coords",
              "latitude": "lat",
              "longitude": "lon"
            },
            "config": {
              "showLegend": false,
              "style": {
                "size": {
                  "fixed": 9
                },
                "color": {
                  "field": "battery",
                  "fixed": "green"
                },
                "symbol": {
                  "mode": "fixed",
                  "fixed": "img/icons/marker/circle.svg"
                },
                "text": {
                  "mode": "field",
                  "field": "drone_id",
                  "fixed": ""
                },
                "textConfig": {
                  "fontSize": 12,
                  "offsetY": -16,
                  "textAlign": "center",
                  "textBaseline": "middle"
                }
              }
            }
          }
        ],
        "tooltip": {
          "mode": "details"
        }
      }
    },
    {
      "id": 6,
      "type": "table",
      "title": "Fleet status",
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb-aeronode"
      },
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 12
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-aeronode"
          },
          "query": "from(bucket: \"telemetry\")\n  |> range(start: -1m)\n  |> filter(fn: (r) => r._measurement == \"telemetry\" and (r._field == \"battery\" or r._field == \"alt\" or r._field == \"speed\" or r._field == \"signal\" or r._field == \"motor_temp\" or r._field == \"distance_home\"))\n  |> filter(fn: (r) => contains(value: r.drone_id, set: ${drone:json}))\n  |> group(columns: [\"drone_id\", \"_field\"])\n  |> last()\n  |> pivot(rowKey: [\"drone_id\", \"mode\"], columnKey: [\"_field\"], valueColumn: \"_value\")\n  |> group()\n  |> keep(columns: [\"drone_id\", \"mode\", \"battery\", \"alt\", \"speed\", \"motor_temp\", \"signal\", \"distance_home\"])\n  |> sort(columns: [\"drone_id\"])"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "center"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
